{
  "hooks": {
    "PreToolUse": [
      {
        "matcher": "Bash",
        "hooks": [
          {
            "type": "command",
            "command": "bash \"$CLAUDE_PROJECT_DIR/.claude/hooks/no-destructive-git.sh\"",
            "timeout": 10,
            "statusMessage": "Проверка на разрушающие git-команды (I10)"
          }
        ]
      }
    ]
  }
}
