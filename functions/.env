# Параметры Cloud Functions (firebase-functions/params). Файл лежит в
# git намеренно: секретов здесь нет (секреты — в Secret Manager, см.
# AGORA_APP_CERTIFICATE и ALGOLIA_ADMIN_KEY), а состояние флагов должно
# быть видно в истории, а не только в консоли GCP.

# Разрешает регулярному сборщику сирот (sweepOrphanMediaDaily) реально
# удалять объекты. false — прогон идёт целиком, но заканчивается
# отчётом: те же цифры, тот же список, ни одного удаления.
#
# Включать ОТДЕЛЬНЫМ шагом и только после того, как отчёт с прода
# сверен: true здесь плюс деплой = сборщик начинает удалять у всех
# сразу. Обратно — так же: false плюс деплой.
ORPHAN_SWEEP_DELETE=true

# То же самое для регулярной проверки живости push-токенов
# (sweepDeadPushTokensDaily, N20). Прогон идёт целиком — обход
# коллекции, проверка каждого токена вхолостую (dryRun у FCM ничего не
# доставляет), запись следа в maintenance/pushTokenSweep/runs, — но при
# false ни один документ не удаляется.
#
# Включать после того, как первый-второй прогон покажет ровно то же, что
# ручной скрипт cleanupPushTokens: тем же порядком, что и со сборщиком
# сирот.
PUSH_TOKEN_SWEEP_DELETE=false
