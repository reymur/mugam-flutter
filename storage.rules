rules_version = '2';

// mugam-club Storage rules — see firestore.rules for the companion
// Firestore rules and the full rationale. Chat-media access is gated by
// cross-referencing the parent chat's `members` array in Firestore, so a
// user who was never in a chat can't read or write its files even with a
// guessed/leaked download URL.

service firebase.storage {
  match /b/{bucket}/o {

    function isSignedIn() {
      return request.auth != null;
    }

    function isChatMember(chatId) {
      return isSignedIn() &&
        request.auth.uid in
          firestore.get(/databases/(default)/documents/chats/$(chatId)).data.members;
    }

    // Single firestore.get() covering both membership and admin/creator
    // status, mirroring firestore.rules' isAdminOrCreator() — used for
    // group-avatar writes below, where both checks are needed together
    // anyway, so one lookup replaces what would otherwise be two.
    function isGroupAdmin(chatId) {
      let chat = firestore.get(/databases/(default)/documents/chats/$(chatId)).data;
      return isSignedIn() && request.auth.uid in chat.members &&
        (request.auth.uid == chat.get('createdBy', null) ||
          request.auth.uid in chat.get('admins', []));
    }

    // Server-side enforcement of the Settings screen's "Maximum file size"
    // slider (users/{uid}.maxUploadSizeMb, validated to [100, 2048] by
    // firestore.rules) — rejects an oversized upload here, before the
    // object ever reaches Storage, rather than uploading it first and
    // deleting it after (which onChatMediaUploaded's onFinalize trigger
    // would otherwise have to do, wasting the transfer and leaving a
    // window where the oversized file briefly exists).
    //
    // УМОЛЧАНИЕ ПРИ ОТСУТСТВУЮЩЕМ ДОКУМЕНТЕ ПРОФИЛЯ — 14.09, решение
    // владельца («б» с условием, а не голое «без профиля»).
    //
    // ЗДЕСЬ СТОЯЛА НЕПРАВДА, И СНЯТА ОНА ЗАМЕРОМ, А НЕ ЧТЕНИЕМ. Прежний
    // комментарий обещал, что `.get()` с умолчанием прикрывает и документ,
    // пропавший целиком («and, defensively, one somehow missing entirely»).
    // Не прикрывает: `.get(поле, умолчание)` — метод КАРТЫ и спасает от
    // пропавшего ПОЛЯ, а у пропавшего ДОКУМЕНТА `firestore.get()` отдаёт
    // `null`, и `.data` на нём рушит всё вычисление правила. Прогон 14.09
    // 04:19 +04: `storage.rules line [43], column [14]. Null value error`.
    // Это ровно I31: обещание защиты читается как проверенная защита.
    //
    // ЧИСЛО НЕ НОВОЕ — ЭТО УСЛОВИЕ РЕШЕНИЯ. 100 есть тот самый предел,
    // который получают сегодня ВСЕ учётки с профилем: перепись прода 14.09
    // 04:34 +04 — **100 МБ у 12 из 12, разных действующих значений одно**
    // (у 3 поле стоит явно и равно 100, у 9 поля нет и работает умолчание
    // строкой ниже). То же число записано ещё дважды на клиенте:
    // `MaxUploadSizeMbNotifier.defaultMb` и `User.maxUploadSizeMb`.
    //
    // ПРЕДЕЛ НЕ СНИМАЕТСЯ, А ПОДСТАВЛЯЕТСЯ: без профиля человек получает те
    // же 100 МБ, а не бесконечность. Снять его значило бы закрыть отказ
    // дырой — и отказ бы исчез, и проверять стало бы нечего.
    //
    // ЧЕГО ЭТО НЕ ЛОВИТ: документ профиля, который ЕСТЬ, но держит в
    // `maxUploadSizeMb` чужой тип (строку вместо числа) — умножение на нём
    // даст ошибку и тот же глухой отказ. Сегодня у поля один писатель и он
    // пишет int (`upload_limit_settings.dart:32-35`); появится второй —
    // проверять тип здесь (I49).
    function maxUploadSizeBytes(uid) {
      let profile = firestore.get(/databases/(default)/documents/users/$(uid));
      return (profile == null ? 100 : profile.data.get('maxUploadSizeMb', 100))
        * 1024 * 1024;
    }

    // avatars/{uid}.jpg — mugam-flutter's uploadAvatar() writes exactly
    // this filename shape (mugam-v2's own avatar upload is a dead stub
    // that always throws, so only this shape is live traffic today).
    // Readable by anyone signed in (avatars are public profile data,
    // matching users/{uid} read access) — writable only by the uid the
    // filename names. Exact-string match, not fileName.split('.')[0] ==
    // uid — split()'s argument is a regex, not a literal separator, so an
    // unescaped '.' matches any character and silently splits on every
    // character instead of the extension dot (confirmed via Rules
    // Playground: fileName.split('.') evaluated to [""]), permanently
    // denying every avatar upload since this rule's introduction.
    // uploadAvatar() always writes '$uid.jpg', so this can just compare
    // the whole filename directly.
    match /avatars/{fileName} {
      allow read: if isSignedIn();
      allow write: if isSignedIn() && fileName == request.auth.uid + '.jpg';
    }

    // chats/{chatId}/{fileName} — mugam-flutter's flat upload shape
    // (exactly one segment under the chat, e.g. chats/{chatId}/{messageId}.
    // jpg). Beyond chat membership, the write must carry customMetadata
    // naming the real uploader/chat — this is what makes that metadata
    // trustworthy by the time onChatMediaUploaded's onFinalize trigger
    // reads it back to write a validatedUploads marker (see
    // firestore.rules): a lying client's upload is rejected here, before
    // the object ever reaches Storage, rather than after.
    match /chats/{chatId}/{fileName} {
      allow read: if isChatMember(chatId);
      allow write: if isChatMember(chatId) &&
        request.resource.metadata.uploaderUid == request.auth.uid &&
        request.resource.metadata.chatId == chatId &&
        request.resource.size <= maxUploadSizeBytes(request.auth.uid);
    }

    // chats/{chatId}/images|voice/{fileName} — mugam-v2's nested upload
    // shape. That app is frozen and can't be updated to attach the same
    // customMetadata, so this stays at the membership-only check it
    // already had; mugam-flutter never writes under this shape at all.
    match /chats/{chatId}/{subfolder}/{fileName} {
      allow read, write: if isChatMember(chatId);
    }

    // statuses/{ownerUid}/{fileName} — statusId is threaded through
    // customMetadata at upload time (generated client-side before the
    // Firestore status doc exists, via newStatusId()/doc().set() — see
    // firestore_service.dart), specifically so this rule can look up the
    // real status document and mirror firestore.rules' `visibleToUids
    // array-contains uid` check exactly (see that rule's comment for why
    // an isContact()-style approximation would be wrong for
    // contactsExcept/onlyShareWith). Write-side can't check visibleToUids
    // (the Firestore doc doesn't exist yet at upload time — upload happens
    // before createStatus) so write access is ownership-only, matching
    // firestore.rules' own create rule for the status doc. Read-side has
    // the same chicken-and-egg problem, one step further: uploadStatusImage/
    // uploadStatusVideo call ref.getDownloadURL() immediately after the
    // upload completes, which is itself a Storage read — but createStatus()
    // (and the visibleToUids it triggers) hasn't run yet at that point, so
    // a visibleToUids-only check would deny the uploader's own
    // getDownloadURL() call every time. The owner-uid bypass below covers
    // exactly that window; visibleToUids covers every other reader once
    // the status is actually live.
    match /statuses/{ownerUid}/{fileName} {
      allow read: if isSignedIn() && (
        request.auth.uid == ownerUid ||
        request.auth.uid in
          firestore.get(/databases/(default)/documents/users/$(ownerUid)/statuses/$(resource.metadata.statusId))
            .data.visibleToUids
      );
      allow write: if isSignedIn() && request.auth.uid == ownerUid &&
        request.resource.metadata.uploaderUid == request.auth.uid &&
        'statusId' in request.resource.metadata &&
        request.resource.size <= maxUploadSizeBytes(request.auth.uid);
    }

    // ГОЛОС ПРИЧИНЫ ВЫХОДА — решение владельца 13.09.
    //
    // СВОЯ ПАПКА, А НЕ ПАПКА ЧАТА, с доводом владельца: голосовое в чате —
    // сообщение переписки, у него свои правила и своё удаление; причина —
    // часть вечера. Одна корзина на две разные вещи однажды унесёт причину
    // вместе с чатом, а круги читателей у чата и у вечера совпадают сегодня
    // случайно.
    //
    // Один файл на человека в вечере: `{uid}` — сам загрузивший.
    //
    // ЧИТАЮТ ВЛАДЕЛЕЦ И САМ ВЫШЕДШИЙ — с 15.09 (N232, шаг 1). ЗДЕСЬ СТОЯЛО
    // «владелец и состав — тот же круг, что у поля `leaveNotes`»: круг поля
    // и круг файла с этого дня РАЗОШЛИСЬ нарочно. Поле по-прежнему читает
    // весь состав (`isParty()` в `firestore.rules`), файл — только двое.
    // Разбор и то, чего сужение НЕ закрывает, — у самого `allow read` ниже
    // и в `docs/n232-token-links.md`.
    //
    // Серверный триггер проверки загрузок (`onChatMediaUploaded`) смотрит
    // только `chats/` и эту папку не трогает.
    match /event_leave_notes/{eventId}/{uid} {
      function leaveEvent() {
        return firestore.get(/databases/(default)/documents/personalEvents/$(eventId)).data;
      }
      // ЧИТАЮТ ДВОЕ: САМ ВЫШЕДШИЙ И ВЛАДЕЛЕЦ ВЕЧЕРА. Состав — НЕ читает.
      //
      // Сужено 15.09 решением владельца (N232, шаг 1). Прежде здесь стояло
      // `request.auth.uid in musicians`, и это расходилось с решением
      // владельца 13.09 «причину видит только владелец»: слушать чужое
      // объяснение мог любой участник того же вечера.
      //
      // `== uid` СТОИТ ПЕРВЫМ НАРОЧНО, две причины:
      //   • у этой ветви нет `firestore.get()`, и при коротком замыкании
      //     `||` чтение своей записи не стоит обращения к Firestore;
      //   • она переживает случай, когда документа вечера уже нет: ветвь
      //     владельца тогда даёт `Null value error`, а автор свою запись
      //     всё равно прочтёт.
      //
      // ЧЛЕНСТВА В СОСТАВЕ У ЧИТАТЕЛЯ БОЛЬШЕ НЕ СПРАШИВАЕМ, и это
      // безопасно: положить файл под своим uid может только участник
      // (правило записи ниже не тронуто), а чтение несуществующего даёт
      // 404, а не чужой файл.
      //
      // ЧЕГО ЭТО СУЖЕНИЕ НЕ ДЕЛАЕТ — сказано здесь, чтобы не прочли шире:
      // ссылка с ключом (`?alt=media&token=`) по-прежнему открывает файл
      // кому угодно и без входа, а лежит она в поле `leaveNotes` документа
      // вечера, которое читает весь состав. Правило отнимает у участника
      // ПРАВО, но не дорогу. Дорогу закрывают шаг 2 и отзыв токенов —
      // `docs/n232-token-links.md`.
      allow read: if isSignedIn() && (
        request.auth.uid == uid ||
        request.auth.uid == leaveEvent().ownerUid
      );
      allow write: if isSignedIn() &&
        request.auth.uid == uid &&
        request.auth.uid in leaveEvent().get('musicians', []) &&
        request.resource.metadata.uploaderUid == request.auth.uid &&
        request.resource.contentType.matches('audio/.*') &&
        request.resource.size <= maxUploadSizeBytes(request.auth.uid);
    }

    // groups/{chatId}/avatar.jpg — mugam-v2's group photo. Any member can
    // read; mugam-v2's UI only shows the upload button to admins, and this
    // now re-enforces that server-side too, so a non-admin member can't
    // bypass the UI restriction via a direct API call.
    //
    // 14.09: КОММЕНТАРИЙ ВЕРНУЛСЯ К СВОЕМУ ПРАВИЛУ. Блок 13.09 про голос
    // причины выхода вклинился между этим текстом и `match /groups/…`, и
    // четыре строки стали читаться как шапка чужого правила. Это I42 на
    // самом опасном расстоянии — не вплотную и не в другом файле, а через
    // экран прокрутки, где расхождение не видно ничем.
    match /groups/{chatId}/{allPaths=**} {
      allow read: if isChatMember(chatId);
      allow write: if isGroupAdmin(chatId);
    }

    // market_images/, videos/ — defined as constants in mugam-v2 but
    // confirmed unused (its upload functions are dead stubs). Denied
    // outright rather than left open: nothing currently depends on a
    // rule here, so if a real feature needs one of these paths in the
    // future, it'll surface as an explicit permission-denied error to
    // fix, not a silent open surface today.
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
