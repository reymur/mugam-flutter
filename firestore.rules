rules_version = '2';

// mugam-club Firestore rules — shared by two client apps against the same
// project: mugam-flutter (this repo) and mugam-v2 (Expo/React Native,
// frozen reference app, source at ../mugam-v2, cannot be modified). Every
// rule below was derived from reading BOTH apps' actual Firestore write
// call sites, not just this repo's — see the audit report / commit message
// this file was introduced with for the full field-by-field justification.
//
// Collections with a precise, deliberately-scoped rule below: users (+
// pushTokens, starred, friends subcollections), chats (+ messages
// subcollection), personalEvents, agreements, invites, friendRequests.
//
// Collections below given a "signed-in only" holding rule (unchanged from
// today's behavior) because neither app's owner/actor field for them could
// be confirmed with full confidence from a read-only audit: gigs, board,
// market, stories, videos, events, rooms, musicians, notifications,
// locations. Tightening these is tracked as follow-up work, not done here,
// specifically to avoid guessing a wrong field name and breaking a
// mugam-v2 feature this project can't test directly.
//
// Anything not matched by any rule below is denied by default (Firestore's
// standard behavior) rather than falling through to an open catch-all —
// if a real feature breaks because its collection isn't listed here, that
// will surface immediately as a permission-denied error, not a silent gap.
//
// OPEN ITEMS (deliberate, not oversights):
//  - chats/{chatId}/messages validSeq() enforces type/range only. The
//    strict `seq == meta/counters.messageSeq + 1` form is written up at
//    that function but not deployed until it can be exercised against
//    concurrent sends in the Firestore emulator — see its comment.
//  - chats/{chatId} `allow read` still permits reading a NON-EXISTENT chat
//    doc (resource == null), which getOrCreateDirectChat's get-before-
//    create depends on. It leaks only "does a chat exist for this uid
//    pair", never content; closing it needs that client call to handle
//    permission-denied as "absent" first.

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null;
    }

    function changedKeys() {
      return request.resource.data.diff(resource.data).affectedKeys();
    }

    // Bounds the user-configurable max-upload-size preference (Settings
    // slider, 100MB-2GB) at the rules level too — storage.rules reads this
    // same field via firestore.get() to reject oversized uploads, so a
    // client writing an out-of-range value here would otherwise let it
    // bypass its own slider UI and self-grant an unbounded upload cap.
    function validMaxUploadSizeMb() {
      return !('maxUploadSizeMb' in request.resource.data) ||
        (request.resource.data.maxUploadSizeMb is int &&
          request.resource.data.maxUploadSizeMb >= 100 &&
          request.resource.data.maxUploadSizeMb <= 2048);
    }

    // ---------------------------------------------------------------
    // users/{userId}
    // ---------------------------------------------------------------
    match /users/{userId} {
      // Public profile directory: home feed, musician picker, About
      // Contact, participant tagging — every one of these reads another
      // user's doc. This was already effectively true (open rules), and
      // nothing in either app treats a user doc as private, so read stays
      // open to any signed-in user.
      allow read: if isSignedIn();

      // Registration (both apps): the new doc's own id must equal the
      // creator's uid — you can only ever create your own profile doc.
      allow create: if isSignedIn() && request.auth.uid == userId
        && validMaxUploadSizeMb();

      // Profile edits: only the owner, and — regardless of what else the
      // update touches — role/verified/goldRing/rating/reviews/gigs/
      // followers/mostRecentStatusExpiresAt/activeStatusIds may never
      // change value via a client update. role/verified/goldRing/rating/
      // reviews/followers/gigs are set once at registration (create,
      // above) and from then on are either permanently fixed
      // (verified/goldRing/role in both apps' actual code) or reserved for
      // a future server-managed feature (rating/reviews/followers/gigs —
      // no client in either app writes these post-creation today).
      // mostRecentStatusExpiresAt/activeStatusIds are different — never
      // set at registration, exclusively written by onStatusCreated/
      // onStatusDeleted (functions/src/index.ts, Admin SDK, bypasses this
      // rule entirely) — guarded here so a client can't self-write either
      // to fake the avatar ring's hasActiveStatus, or corrupt
      // activeStatusIds with a stale/forged entry (lib/firebase/
      // models.dart). Not an access-control gap either way: forging a
      // statusId into activeStatusIds doesn't itself grant read access to
      // that status — get() is independently re-checked against the
      // status doc's own isPublic/privacyList/visibleToUids every time,
      // regardless of what this array contains; this guard is purely about
      // keeping the array itself truthful. Comparing request.resource.data.X
      // to resource.data.X passes
      // automatically for any update that doesn't touch X at all (a plain
      // .update() call preserves untouched fields), so this never blocks
      // the real profile-edit flows (updateUserProfile, setUserOnline,
      // saveReadAgreementId).
      allow update: if isSignedIn() && request.auth.uid == userId
        && request.resource.data.get('role', null) == resource.data.get('role', null)
        && request.resource.data.get('verified', null) == resource.data.get('verified', null)
        && request.resource.data.get('goldRing', null) == resource.data.get('goldRing', null)
        && request.resource.data.get('rating', null) == resource.data.get('rating', null)
        && request.resource.data.get('reviews', null) == resource.data.get('reviews', null)
        && request.resource.data.get('gigs', null) == resource.data.get('gigs', null)
        && request.resource.data.get('followers', null) == resource.data.get('followers', null)
        && request.resource.data.get('mostRecentStatusExpiresAt', null) ==
             resource.data.get('mostRecentStatusExpiresAt', null)
        && request.resource.data.get('activeStatusIds', null) ==
             resource.data.get('activeStatusIds', null)
        && validMaxUploadSizeMb();

      allow delete: if false;

      // users/{uid}/pushTokens/{deviceId} — mugam-v2's client reads
      // another user's tokens directly to send an Expo push itself, so
      // read must stay open to any signed-in user; only the owning
      // device/uid may register or remove its own token.
      match /pushTokens/{deviceId} {
        allow read: if isSignedIn();
        allow write: if isSignedIn() && request.auth.uid == userId;
      }

      // users/{uid}/starred/{messageId} — mugam-flutter only, a private
      // per-user bookmark list. Owner-only in both directions.
      match /starred/{starredId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // users/{uid}/seenInvitations/{eventId} — «я это приглашение видел».
      // Заведено 12.08 для числа непросмотренных на клетке календаря.
      //
      // ЛЕЖИТ У ЧЕЛОВЕКА, А НЕ НА МЕРОПРИЯТИИ, и это разбор, а не удобство.
      // Поле на самом вечере участнику писать НЕЛЬЗЯ: `answersForSelf()`
      // требует `changedKeys().hasOnly(['answers'])`, и узость эта намеренная
      // — ею же закрыт I54 (поле, по которому сервер судит о смысле
      // произошедшего, отданное участнику). Расширять её ради пометки о
      // просмотре — плохой размен. **И по существу: «я это видел» — факт про
      // ЧЕЛОВЕКА, а не про вечер**, ему и место у человека.
      //
      // Форма та же, что у `starred` ниже: личная пометка, ключ — id
      // документа, владелец в обе стороны. Второй такой же случай, и это
      // довод за одинаковую форму, а не за общий блок: коллекции разные, и
      // сводить их значило бы сводить по совпадению вида (I58).
      match /seenInvitations/{eventId} {
        allow read, write: if isSignedIn() && request.auth.uid == userId;
      }

      // users/{uid}/friends/{friendUid} — "these two users are confirmed
      // friends," maintained exclusively by the onFriendRequestUpdated /
      // onFriendRequestDeleted triggers in functions/src/index.ts (Admin
      // SDK, bypasses rules) once a friendRequests/{requestId} doc reaches
      // status 'accepted' (or is later deleted). Deliberately no `allow
      // write` at all: a client write here would let a user forge a false
      // friendship signal and have themselves added to a contacts-mode
      // status's visibleToUids (via onStatusCreated / the propagation
      // triggers reading this collection). Read is owner-only, and safe as
      // both a get() AND a full-collection list query (unlike the old
      // statuses isContact()/exists() problem) — the condition depends only
      // on the path segment `userId` matching request.auth.uid, never on
      // document field data, so Firestore can prove it statically for every
      // possible result a list query could return. The client reads its own
      // friends list here for the Status creation privacy picker (choosing
      // who's in a contactsExcept/onlyShareWith list).
      match /friends/{friendUid} {
        allow read: if isSignedIn() && request.auth.uid == userId;
      }

      // users/{uid}/statuses/{statusId} — a WhatsApp-style 24h status post.
      // See lib/firebase/models.dart's Status class for the field shapes
      // referenced below (privacyMode/privacyList/visibleToUids in
      // particular).
      //
      // Access is gated on visibleToUids, a denormalized array of every uid
      // currently allowed to see this status — NOT recomputed from
      // privacyMode/privacyList/friends here. An exists()-based "is this
      // reader a friend" check (the previous approach) only ever works for
      // a single getDoc() of a known document id; it cannot support a real
      // list/collectionGroup query, because Firestore only allows a list
      // query when its security rule can be evaluated using solely the
      // query's own filters (plus request.auth) — it never runs the rule
      // against documents outside what the query already constrains, so a
      // rule that reads another document via exists()/get() can't gate a
      // list read. visibleToUids is written exclusively by Cloud Functions
      // (onStatusCreated at creation, then kept in sync by the
      // friend-change propagation in onFriendRequestUpdated/
      // onFriendRequestDeleted — see functions/src/index.ts) specifically
      // so `visibleToUids array-contains request.auth.uid` can be both the
      // query filter AND the rule condition.
      //
      // The read rule itself is declared separately, in a top-level
      // `match /{path=**}/statuses/{statusId}` block below (NOT here) —
      // confirmed by testing (status-feed-query.test.ts) that a rule
      // nested inside match /users/{userId} {...}, like this block, DOES
      // authorize a plain get()/collection() read at the exact nested path,
      // but is NOT matched by a collectionGroup('statuses') query — only a
      // rule declared with the recursive wildcard path is. Since the real
      // feed access pattern is exactly that collectionGroup query, the read
      // rule has to live there, not here.
      match /statuses/{statusId} {
        // The client must never set visibleToUids itself — only the
        // onStatusCreated trigger (Admin SDK, bypasses rules) may, once the
        // doc already exists. A client-supplied value here would let a
        // user grant themselves (or anyone) read access outright.
        allow create: if isSignedIn() && request.auth.uid == userId
          && !('visibleToUids' in request.resource.data);

        // Statuses are immutable after posting, same as WhatsApp — this
        // also blocks a client from ever rewriting visibleToUids post-
        // creation (the Cloud Functions above use the Admin SDK, which
        // bypasses rules entirely, so they're unaffected by this).
        allow update: if false;
        allow delete: if isSignedIn() && request.auth.uid == userId;

        match /viewers/{viewerUid} {
          // ONLY the status owner can LIST/see the full who-viewed-me set —
          // confirmed via search that WhatsApp never shows viewers to each
          // other. A viewer may additionally get() their own single record
          // (viewerUid must equal their own uid, matching the path segment
          // exactly the same provably-safe way as the friends rule above)
          // so the client can render "have I already viewed this status"
          // for the ring UI — this does NOT let them list or read anyone
          // else's viewer doc.
          allow read: if isSignedIn()
            && (request.auth.uid == userId || request.auth.uid == viewerUid);

          allow create, update: if isSignedIn() && request.auth.uid == viewerUid
            && request.auth.uid != userId // owner doesn't "view" their own status
            && request.auth.uid in
                 get(/databases/$(database)/documents/users/$(userId)/statuses/$(statusId)).data.visibleToUids
            // Enforces the timestamp is the real server request time, not
            // a client-supplied value — standard anti-spoofing pattern.
            && request.resource.data.viewedAt == request.time;

          // Viewer records are cleaned up only via the onStatusDeleted
          // cascade (functions/src/index.ts), never removable individually.
          allow delete: if false;
        }
      }
    }

    // ---------------------------------------------------------------
    // users/{uid}/statuses/{statusId} read access for collectionGroup
    // queries — see the long comment on match /statuses/{statusId} above
    // for why this can't just live inside that nested block. request.auth
    // is available for a query request the same as a get(), and Firestore
    // resolves this block for a get()/collection() read at the concrete
    // nested path too (a match with `{path=**}` matches any prefix,
    // including "users/{uid}"), so this is the single, sufficient
    // declaration of the read rule — the nested block above intentionally
    // has none.
    //
    // Split into `get` and `list` (rather than one combined `read`) because
    // they now have genuinely different audiences. `list` is unchanged from
    // before this split — the visibleToUids-based check the feed's own
    // collectionGroup query filters on (see watchStatusFeed's own comment,
    // firestore_service.dart) — and must keep behaving identically, since
    // Firestore only authorizes that query when this exact rule shape can
    // be proven from the query's own filters alone. `get` is new: a direct
    // single-doc read (e.g. viewing one specific person's status from their
    // profile, not through the friends-scoped feed) is authorized by
    // isPublic — server-computed by onStatusCreated alongside visibleToUids
    // (functions/src/index.ts) — for anyone except a uid the owner
    // explicitly excluded via privacyList (only meaningful for
    // 'contactsExcept'; empty for every other mode). visibleToUids still
    // authorizes get() too, so 'onlyShareWith' (isPublic: false) and any
    // legacy doc from before isPublic existed remain readable exactly as
    // before via that same fallback.
    match /{path=**}/statuses/{statusId} {
      allow list: if isSignedIn() && request.auth.uid in resource.data.visibleToUids;

      allow get: if isSignedIn() && (
        (resource.data.get('isPublic', false) == true &&
          !(request.auth.uid in resource.data.get('privacyList', []))) ||
        request.auth.uid in resource.data.visibleToUids
      );
    }

    // ---------------------------------------------------------------
    // chats/{chatId}  (+ messages/{messageId})
    // ---------------------------------------------------------------
    match /chats/{chatId} {
      function isMember() {
        return isSignedIn() && request.auth.uid in resource.data.members;
      }
      function willBeMember() {
        return isSignedIn() && request.auth.uid in request.resource.data.members;
      }
      function isAdminOrCreator() {
        return isSignedIn() && (
          request.auth.uid == resource.data.get('createdBy', null) ||
          request.auth.uid in resource.data.get('admins', [])
        );
      }
      // "Leaving a group" removes exactly your own uid from a list and
      // adds nobody — this is the one members/admins mutation a non-admin
      // is allowed to make. Anything else touching members/admins
      // (adding anyone, or removing someone who isn't you) requires
      // isAdminOrCreator() instead.
      function isSelfRemovalOnly(oldList, newList) {
        return oldList.hasAll(newList)
          && newList.size() == oldList.size() - 1
          && !(request.auth.uid in newList)
          && request.auth.uid in oldList;
      }
      function isSafeMembershipChange() {
        return isAdminOrCreator() || (
          (!('members' in changedKeys()) ||
            isSelfRemovalOnly(resource.data.members, request.resource.data.members)) &&
          (!('admins' in changedKeys()) ||
            isSelfRemovalOnly(resource.data.get('admins', []), request.resource.data.get('admins', [])))
        );
      }

      // Only current members can see a chat — this is the core fix: no
      // more "any signed-in user reads any chat." resource == null is the
      // one exception: a get() on a chat that doesn't exist yet (e.g.
      // FirestoreService.getOrCreateDirectChat's own upfront existence
      // check, before the chat is created) must not error out just
      // because resource.data can't be evaluated on a null resource —
      // Firestore's own documented pattern for this exact "get-before-
      // create" case. Harmless for list queries (resource is always a
      // real matched doc there, never null) and doesn't weaken anything
      // for an EXISTING chat — isMember() is still required exactly as
      // before in that case.
      allow read: if resource == null || isMember();

      // Group chats are created client-side by mugam-flutter itself (see
      // createGroupChat below — no Cloud Function needed for creation,
      // only for the creator-immunity-gated deleteGroupChat). Direct (1:1)
      // chats are now ALSO created client-side by mugam-flutter, at a
      // deterministic sorted-uid-pair doc id (see
      // FirestoreService.getOrCreateDirectChat/directChatDocId) — this is
      // what makes a simultaneous create from both sides race-safe without
      // a transaction, since a second write to the same id is evaluated as
      // `update` below, not a second `create`. mugam-v2 (still running on
      // this same backend — see functions/src/index.ts's own Expo-push-
      // dedup comment) separately creates both chat types itself with
      // random addDoc() ids of its own, unaffected by any of this. Either
      // way, the creator must be listed in the members array they're
      // writing.
      allow create: if willBeMember();

      // "Çatı təmizlə" is a PER-USER view cutoff: clearedBy.{uid} hides
      // every message up to that moment for that one uid alone. Letting a
      // member write another member's key here would let them silently
      // wipe the other party's entire visible history — the one entry in
      // the otherwise-permissive field list below whose cross-uid write has
      // no legitimate caller in either app (both apps' clearChatForUser
      // only ever write their own uid; see FirestoreService.clearChatForUser).
      function writesOnlyOwnClearedBy() {
        return !('clearedBy' in changedKeys()) ||
          request.resource.data.clearedBy
            .diff(resource.data.get('clearedBy', {}))
            .affectedKeys()
            .hasOnly([request.auth.uid]);
      }
      // Legacy field: the seq allocator lives in meta/counters now (see
      // that match block and FirestoreService._commitMessage). Nothing
      // writes this on update anymore in either app — createGroupChat sets
      // it once at create time and it's been frozen since. Pinning it here
      // keeps it usable as the migration seed floor (_resolveSeedFloor
      // takes max(newest message's seq, this) when a chat's counter doc is
      // missing) without a member being able to inflate it.
      function messageSeqUnchanged() {
        return request.resource.data.get('messageSeq', null) ==
          resource.data.get('messageSeq', null);
      }

      // Every ordinary field on a chat doc (lastMessage, lastMessageTime,
      // deliveredTo.{uid}, deliveredSeq.{uid}, deliveredAt.{uid},
      // lastReadAt.{uid}, lastReadMsgId.{uid},
      // unreadCount.{uid}, activeUsers, typing.{uid}, name, photoURL,
      // cancelledBy, closedBy, jobOfferBy, eventDate/Type/
      // Location/Notes, waitingForDateAt, preview, ...) stays writable by
      // ANY current member, including writes keyed by a DIFFERENT member's
      // uid — this is real, confirmed behavior in both apps (e.g. the
      // sender writes the recipient's deliveredTo/unreadCount entry), not a
      // hole to close. Three carve-outs: members/admins (membership), and
      // now clearedBy (destructive cross-uid) + messageSeq (allocator
      // integrity).
      // «КТО ЭТО СДЕЛАЛ» НЕЛЬЗЯ НАПИСАТЬ ЗА ДРУГОГО (N37).
      //
      // Три поля переговоров — `cancelledBy`, `roundEndedBy`, `jobOfferBy`
      // — заведены РАДИ СЕРВЕРА: по ним он называет автора в уведомлении
      // и по ним же обе стороны читают историю раунда
      // (`roundEndedBy == jobOfferBy` значит «инициатор передумал», иначе
      // «получатель отказался»). До 04.08 их мог написать любой участник
      // с любым uid, и получатель, записав `cancelledBy` с uid
      // инициатора, оставлял в документе неправду: у одного экран
      // говорил «вы отказались», у другого «он отказался». Тот же вред,
      // что у N36, — «отказался Х» переставало значить «решение принял Х».
      //
      // Найдено сплошным проходом по классу «подделывается не действие, а
      // рассказ о нём»: подделывается тут не поступок, а рассказ о нём, и
      // снаружи подделка неотличима от правды.
      //
      // ТРИ ДОПУСТИМЫХ ИСХОДА, и первый из них обязателен:
      //
      //   1. поле НЕ МЕНЯЕТСЯ. Без этого пункта правило запретило бы любую
      //      обычную правку соседних полей — а `.update()` по нескольким
      //      ключам приносит остальные в `request.resource.data` со
      //      старыми значениями, и сравнение их пропускает само собой.
      //      Сравниваются именно ЗНАЧЕНИЯ, а не `changedKeys()`: последний
      //      не видит записи тем же значением (см. запись про
      //      `changedKeys()` в реестре), и правило на нём давало бы щель
      //      ровно там, где её уже находили;
      //   2. поле очищается в `null` — начался новый раунд (`setJobOffer`).
      //      Стирание записи о человеке ложью о нём не является: оно
      //      никого не называет;
      //   3. поле указывает на САМОГО пишущего — единственный способ
      //      что-то в него записать.
      //
      // Тот же приём, что у `stampsSelf` в personalEvents, `onlyAddsSelfTo`
      // в сообщениях и `writesOnlyOwnClearedBy` выше — пятое его
      // применение в проекте.
      function namesOnlySelf(field) {
        let after = request.resource.data.get(field, null);
        return after == resource.data.get(field, null)
          || after == null
          || after == request.auth.uid;
      }

      allow update: if isMember()
        && (!changedKeys().hasAny(['members', 'admins']) || isSafeMembershipChange())
        && writesOnlyOwnClearedBy()
        && messageSeqUnchanged()
        && namesOnlySelf('cancelledBy')
        && namesOnlySelf('roundEndedBy')
        && namesOnlySelf('jobOfferBy');

      allow delete: if false;

      match /messages/{messageId} {
        function parentMembers() {
          return get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }
        function isChatMember() {
          return isSignedIn() && request.auth.uid in parentMembers();
        }
        function isSender() {
          return isSignedIn() && request.auth.uid == resource.data.senderId;
        }

        // Firestore rules can't see into Storage, so a media message's
        // imageURL/videoURL/audioURL string can't be trusted on its own —
        // it could be an arbitrary external URL, or a real file from a
        // chat the sender was never in. mediaOriginChatId/mediaFileName
        // point at a validatedUploads marker that only the
        // onChatMediaUploaded Storage trigger can write (Admin SDK,
        // bypasses rules), and the sender must additionally still be a
        // member of THAT chat — this is what makes forwarding a message
        // from an earlier chat safe: the file doesn't need to be
        // re-uploaded, but the forwarder must have had legitimate access
        // to it.
        function isValidatedMedia() {
          let originChatId = request.resource.data.get('mediaOriginChatId', null);
          let fileName = request.resource.data.get('mediaFileName', null);
          return originChatId != null && fileName != null &&
            request.auth.uid in
              get(/databases/$(database)/documents/chats/$(originChatId)).data.members &&
            exists(
              /databases/$(database)/documents/validatedUploads/$(originChatId)/files/$(fileName)
            );
        }
        // Scoped to mugam-flutter's own messages only (clientPlatform is a
        // field only this app sets) — mugam-v2 can't be modified to supply
        // mediaOriginChatId/mediaFileName, so its media messages keep the
        // sender+membership check below without the extra validation.
        function needsValidatedMedia() {
          return request.resource.data.get('clientPlatform', null) == 'flutter' &&
            request.resource.data.type in ['image', 'video', 'audio', 'file', 'location'];
        }

        // `seq` is the sole ordering key for every message query in
        // mugam-flutter (watchMessages/fetchOlderMessages/
        // watchOlderMessagesInRange/watchChatMedia/_findLastMessage all
        // orderBy('seq')), and startAt/endBefore pagination bounds are seq
        // values — so an arbitrary client-chosen seq isn't just a wrong
        // position for one bubble, it corrupts ordering and pagination for
        // every member of the chat.
        //
        // Type/range check only, deliberately. The strict form of this rule
        // is `seq == get(.../meta/counters).data.messageSeq + 1`, pinning
        // every message to the allocator FirestoreService._commitMessage
        // actually bumps. That version is NOT deployed, on purpose: it
        // depends on which snapshot a rules-side get() observes while the
        // send transaction that writes BOTH the message and the counter is
        // committing, under concurrent sends to the same chat. The
        // documented behaviour says it sees pre-commit state (which would
        // make it correct), but a wrong assumption there fails closed —
        // every send in the app starts being rejected — and it's exactly
        // the kind of concurrency-dependent failure that a quiet two-device
        // test would pass while real traffic later would not. The residual
        // exposure without it is a deliberately-modified client writing a
        // bogus seq, which is a targeted attack by an existing chat member,
        // not an everyday failure — a worse trade than risking send
        // breakage for everyone.
        //
        // TODO(rules): restore the strict `seq == counter + 1` form once it
        // can be exercised against concurrent sends in the Firestore
        // emulator rather than validated in production.
        //
        // Only enforced when `seq` is present at all — and omitting it is
        // self-defeating as an attack, since Firestore excludes documents
        // missing the orderBy field from an orderBy query entirely, so a
        // seq-less message never appears in any of this app's message
        // queries in the first place.
        function validSeq() {
          return !('seq' in request.resource.data) || (
            request.resource.data.seq is int &&
            request.resource.data.seq > 0
          );
        }
        // Display-only (the HH:mm on the bubble) — ordering is seq, so a
        // skewed value here is cosmetic rather than structural. Bounded
        // only against absurd far-future values used to make a message look
        // permanently "newest"; the 1-day slack keeps ordinary device-clock
        // skew (this is written as a client Timestamp.now()) from ever
        // tripping it.
        function validTimestamp() {
          return !('timestamp' in request.resource.data) || (
            request.resource.data.timestamp is timestamp &&
            request.resource.data.timestamp.toMillis() <
              request.time.toMillis() + 86400000
          );
        }

        allow read: if isChatMember();

        // A message's senderId must be the writer's own uid. The previous
        // `|| senderId == 'system'` escape hatch existed only for mugam-v2
        // (retired — no longer in use against this backend), and it let ANY
        // member forge a message that renders as an authoritative system
        // notice. mugam-flutter never needed it: its own system messages
        // are written with the real actor's uid plus isSystem: true (see
        // FirestoreService.createGroupChat/leaveGroup/addGroupMember),
        // specifically so the onNewMessage push trigger resolves a real
        // name. Cloud Functions are unaffected either way — the Admin SDK
        // bypasses rules entirely.
        allow create: if isChatMember()
          && request.resource.data.senderId == request.auth.uid
          && (!needsValidatedMedia() || isValidatedMedia())
          && validSeq()
          && validTimestamp();

        // Two legitimate non-sender update shapes, plus one sender-only
        // shape. Reactions are NOT listed here on purpose: they're written
        // exclusively by the toggleMessageReaction Cloud Function (Admin
        // SDK, bypasses rules) — a direct client write to `reactions`
        // can't be validated at the field-content level (rules see "the
        // map changed", not "only the caller's own uid moved within it"),
        // so it's blocked here entirely rather than trusted.
        //  - listenedBy: any member marks their own uid as having played
        //    a voice note (mugam-flutter).
        //  - deletedFor: any member hides a message (any sender) for
        //    themself only.
        //  - text / deletedForAll / deletedAt / imageURL / videoURL /
        //    audioURL: only the original sender may touch these (message
        //    edit, delete-for-everyone, or mugam-v2's post-send CDN-URL
        //    swap-in).
        //
        // Both non-sender shapes are additionally pinned to the caller's
        // OWN uid: the field list alone said "listenedBy changed" /
        // "deletedFor changed", not "and only by adding yourself", so any
        // member could previously rewrite either array wholesale — hiding
        // a message for somebody else (deletedFor), or forging/erasing
        // another user's "played this voice note" state (listenedBy).
        // Both apps only ever add their own uid via arrayUnion (see
        // FirestoreService.deleteMessageForMe / markVoiceMessageListened),
        // so nothing legitimate needs the wider latitude.
        function onlyAddsSelfTo(field) {
          let oldList = resource.data.get(field, []);
          let newList = request.resource.data.get(field, []);
          return newList.hasAll(oldList) &&
            newList.hasOnly(oldList.concat([request.auth.uid]));
        }
        allow update: if isChatMember() && (
          (changedKeys().hasOnly(['listenedBy']) && onlyAddsSelfTo('listenedBy')) ||
          (changedKeys().hasOnly(['deletedFor']) && onlyAddsSelfTo('deletedFor')) ||
          (isSender() && changedKeys().hasOnly(
            ['text', 'deletedForAll', 'deletedAt', 'imageURL', 'videoURL', 'audioURL']
          ))
        );

        // Hard delete, now bounded to the two legitimate shapes instead of
        // "any member may destroy any message":
        //  - isSender(): your own message, unconditionally.
        //  - already deletedForAll: mugam-flutter's opportunistic purge
        //    (chat_screen.dart's _schedulePurgeTimers) hard-deletes a
        //    tombstoned message ~5 minutes after deletedAt, and it runs on
        //    whichever member's client happens to have the chat open then
        //    — routinely NOT the sender. That path only ever targets a
        //    message the sender themself already tombstoned via
        //    deleteMessageForAll, so allowing it grants nothing new.
        //
        // The wide-open version this replaces existed to keep mugam-v2's
        // GroupChat swipe-delete (any member could permanently delete any
        // other member's message, no ownership check) working. That app is
        // retired, so the compatibility reason is gone. mugam-flutter was
        // never relying on it — all three of its "Hamıdan sil" call sites
        // are already gated on isMe/allMine (chat_screen.dart,
        // chat_attachment_viewer_screen.dart, video_message_widgets.dart),
        // so it never deletes a message it didn't send except through the
        // tombstone purge above.
        allow delete: if isChatMember() && (
          isSender() || resource.data.get('deletedForAll', false) == true
        );
      }

      // ---------------------------------------------------------------
      // chats/{chatId}/meta/{metaId} — currently just "counters"
      // ---------------------------------------------------------------
      // Holds the messageSeq allocator FirestoreService._commitMessage
      // reads/increments transactionally — moved off the main chat doc
      // specifically so that transaction no longer contends with every
      // other write to that doc (typing, lastReadAt, deliveredTo,
      // negotiationSeenAt, ...). Same membership check as messages/ above
      // (isChatMember(), redefined here since Firestore rules functions
      // aren't visible across sibling `match` blocks) — any current member
      // needs both read (to compute the next seq) and write (to bump it),
      // same as the old messageSeq field on the main doc allowed for any
      // member via this match block's own `allow update` above.
      match /meta/{metaId} {
        function isChatMember() {
          return isSignedIn() &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }
        // create/update only — deliberately NOT `write`, which would also
        // grant delete. Deleting the counters doc makes the next send
        // re-seed the allocator, and while _resolveSeedFloor now recovers
        // the real high-water mark from the newest message (so a re-seed no
        // longer hands out a duplicate seq), there is no legitimate reason
        // for a client to remove it at all — the allocator is append-only
        // per chat for the life of the chat.
        allow read, create, update: if isChatMember();
        allow delete: if false;
      }

      // ---------------------------------------------------------------
      // chats/{chatId}/offers/{offerId} — предложение работы
      // ---------------------------------------------------------------
      // Предложение стало ОТДЕЛЬНЫМ документом (решение автора 13.08).
      // До этого оно жило четырнадцатью полями на самом документе чата, и
      // главный довод за переезд — здешний: документ чата пишется при
      // каждом нажатии клавиши (typing, deliveredTo, unreadCount,
      // lastReadAt), и правило над ним признаёт это прямо — любое обычное
      // поле пишет любой участник. Отметки дней там не защитить, не тронув
      // правило, через которое ходит вся доставка. Здесь же правила
      // пишутся с чистого листа и не задевают ни одного существующего пути.
      //
      // Четырнадцать старых полей НЕ ТРОГАЮТСЯ и продолжают жить: они
      // держат предложения, созданные прежним путём. Новый экран их не
      // показывает (решение автора 13.08 — у старой формы отметок по дням
      // нет вовсе), удаляются они отдельной работой, когда не останется
      // старых сборок.
      //
      // ФОРМА:
      //   createdBy/createdAt/anchorMessageId — кто, когда, где карточка
      //   dates            ['2026-08-09', …] — дни предложения
      //   eventType        один на всё предложение — Toy, Konsert
      //   details          { '2026-08-09': {time, location, dress, …} }
      //                    — У КАЖДОГО ДНЯ СВОИ, общих полей нет (14.08).
      //                    Прежде здесь стояли eventTime/eventLocation/
      //                    eventNotes — одни на все вечера предложения;
      //                    звали на пять дней, время выходило одно.
      //   answers          { uid: ['2026-08-09', …] } — отмеченные дни
      //   acceptedBy/acceptedAt    — «Qəbul edirəm», ход инициатора
      //   withdrawnBy/withdrawnAt  — отзыв, ход инициатора
      //
      // ОТМЕТКИ ЛЕЖАТ КАРТОЙ ПО uid, А НЕ ОБЩИМ СПИСКОМ, и это не про
      // будущих нескольких музыкантов. В общем списке свою отметку от
      // чужой не отличить — правило «трогать только своё» стало бы
      // невыразимым, и пришлось бы верить экрану. Тот же приём и по той же
      // причине, что `answers` у personalEvents.
      //
      // ГОЛОСОВОЕ СЮДА НЕ ПИШЕТСЯ. `offerId` едет полем на сообщении типа
      // audio, карточка находит свои записи запросом по нему. Список id на
      // предложении завёл бы пятый ход — дописывание, — а проверить его
      // нечем: правило не может дёшево убедиться, что дописываемый id
      // принадлежит сообщению ЭТОГО участника. На сообщениях
      // `senderId == request.auth.uid` уже стоит, значит «кто записал»
      // держится тем, что есть, и новых правил не нужно вовсе.
      //
      // ОДИН ДОКУМЕНТ — ОДИН ОТВЕТ (граница, названная автором 13.08).
      // Сегодня в чате один музыкант. Звать нескольких одним предложением
      // — ДРУГАЯ РАБОТА, а не правка этой: карта по uid форму выдержит, но
      // «принято» станет частичным (троих взяли, двоих нет), а это уже
      // другой ход, а не тот же с поправкой.
      match /offers/{offerId} {
        function isChatMember() {
          return isSignedIn() &&
            request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
        }
        function isInitiator() {
          return request.auth.uid == resource.data.createdBy;
        }
        function changedKeys() {
          return request.resource.data.diff(resource.data).affectedKeys();
        }
        // Раунд закрыт принятием или отзывом. После любого из них отметки
        // не принимаются: иначе «принято на три дня» и отметки под ним
        // разъедутся, и сказать, на что именно согласились, будет нечем.
        function roundOpen() {
          return !('acceptedBy' in resource.data)
            && !('withdrawnBy' in resource.data);
        }
        // Отметки правит ТОЛЬКО ТОТ, ЧЬИ ОНИ. `affectedKeys` по вложенной
        // карте отвечает на «чья запись сдвинулась», и этого достаточно:
        // чужую отметку нельзя ни поставить, ни стереть, ни переписать —
        // все три случая двигают чужой ключ.
        function touchesOnlyOwnAnswer() {
          return request.resource.data.answers
            .diff(resource.data.answers)
            .affectedKeys()
            .hasOnly([request.auth.uid]);
        }
        // ДЕНЬ, КОТОРОГО В ПРЕДЛОЖЕНИИ НЕТ, ОТМЕТИТЬ НЕЛЬЗЯ. Без этой
        // проверки отметка «20-е» прошла бы молча и попала бы в вечера при
        // принятии — день, которого работодатель не предлагал. Пустой
        // список законен: это «не могу ни на один», а не отсутствие
        // ответа, и `hasOnly` его пропускает сам собой.
        function answerFitsOffer() {
          return request.resource.data.answers
            .get(request.auth.uid, [])
            .hasOnly(resource.data.dates);
        }

        allow read: if isChatMember();

        // Создаёт только инициатор, и назвать себя обязан сам — тот же
        // приём, что `namesOnlySelf` на jobOfferBy/cancelledBy выше.
        // `answers` при создании пуст: отметка за музыканта, поставленная
        // вперёд него, — это тот же подлог, что чужой cancelledBy (N37).
        allow create: if isChatMember()
          && request.resource.data.createdBy == request.auth.uid
          && request.resource.data.keys().hasOnly([
            'createdBy', 'createdAt', 'anchorMessageId', 'dates',
            'eventType', 'details', 'answers',
          ])
          && request.resource.data.dates is list
          && request.resource.data.dates.size() > 0
          // ВЕРХНИЙ ПРЕДЕЛ ДНЕЙ. Вечера по «Qəbul edirəm» создаёт клиент
          // ОДНОЙ пачкой: N вечеров плюс отметка о принятии одной
          // операцией. Предел в 500 операций на Commit взят извне и нами
          // не мерен (I6), поэтому правило заменяет «влезает по здравому
          // смыслу» на «влезает доказуемо». 31 — длина самого длинного
          // месяца: больше в одном предложении и не звали ни разу.
          && request.resource.data.dates.size() <= 31
          // ДЛИНА ТИПА РАБОТЫ. `eventType` пишется СВОБОДНЫМ ТЕКСТОМ —
          // выбрал «Digər», вписал своё, — и до 19.08 размер не проверялся
          // нигде. Строка предложения в ленте («N gün · <тип> · <исход>»)
          // от этого не ограничена ничем.
          //
          // **Ограничение стоит ЗДЕСЬ, а не в показе, и это решение
          // автора 19.08.** Тип показывается в четырёх местах — строка
          // ленты, лист, карточка вечера, календарь; обрезать в каждом
          // значит завести четыре расходящихся решения. Правило одно и не
          // пускает длинное в базу.
          //
          // Замер прода 19.08 (`censusOfferDetails`/`censusEventTypeLength`,
          // только чтение): 14 предложений, «Toy» — 13 (3 знака),
          // свободный текст — 1 («vvvbbbb», 7 знаков). **Свободный текст
          // уже используется**, это не теория. Самое длинное из списка —
          // `Konsert`, 7 знаков; 24 даёт втрое больше на своё название.
          && request.resource.data.eventType.size() <= 24
          && request.resource.data.answers.keys().size() == 0;

        // ТРИ ФОРМЫ ПРАВКИ, И ОНИ НЕ ПЕРЕСЕКАЮТСЯ.
        //
        //   1. музыкант отмечает свои дни;
        //   2. инициатор принимает;
        //   3. инициатор отзывает.
        //
        // ЧЕГО НИ ОДНА ИЗ ТРЁХ НЕ ПОЗВОЛЯЕТ — и это важнее самих форм:
        //
        //   • музыканту тронуть dates, eventType, details: их нет в его
        //     `hasOnly`. `details` назван здесь ИМЕННО ПОТОМУ, что он
        //     один держит время, место и одежду всех дней сразу — до
        //     14.08 на его месте стояли три поля, и запрет перечислял их;
        //   • ИНИЦИАТОРУ переписать dates задним числом — САМЫЙ ТИХИЙ ИЗ
        //     ЗАПРЕТОВ. Отметки, поставленные под старые дни, молча
        //     означали бы согласие на новые: экран показал бы «согласен на
        //     9-е и 11-е» там, где человек соглашался совсем на другое.
        //     Ни в одной из трёх форм `dates` не назван, поэтому тронуть
        //     его нельзя вовсе — ни до отметок, ни после;
        //   • инициатору подправить отметки музыканта — иначе «он
        //     согласился на 9-е» перестаёт значить «решил он» (N36, N37);
        //   • музыканту принять или отозвать: создание вечеров — ход
        //     инициатора, и держать это обязано правило, а не экран;
        //   • кому угодно сменить createdBy, createdAt, anchorMessageId;
        //   • кому угодно отметить или принять после закрытия раунда.
        //
        // Отозвать ПРИНЯТОЕ нельзя (roundOpen() закрывает и это): по
        // «Qəbul edirəm» вечера уже созданы, и отзыв после них означал бы
        // их снятие — другой ход с другими последствиями. Передумал после
        // принятия — отменяет вечер, а не предложение.
        allow update: if isChatMember() && roundOpen() && (
          (
            !isInitiator()
            && changedKeys().hasOnly(['answers'])
            && touchesOnlyOwnAnswer()
            && answerFitsOffer()
          ) || (
            isInitiator()
            && changedKeys().hasOnly(['acceptedBy', 'acceptedAt'])
            && request.resource.data.acceptedBy == request.auth.uid
          ) || (
            isInitiator()
            && changedKeys().hasOnly(['withdrawnBy', 'withdrawnAt'])
            && request.resource.data.withdrawnBy == request.auth.uid
          )
        );

        // Предложение — история переписки. Через месяц человек должен его
        // найти, значит исчезнуть оно не должно ни у одной стороны.
        allow delete: if false;
      }
    }

    // ---------------------------------------------------------------
    // validatedUploads/{chatId}/files/{fileName}
    // ---------------------------------------------------------------
    // Written exclusively by onChatMediaUploaded via Admin SDK (bypasses
    // rules — no `allow write` here is intentional, a client write is
    // never legitimate). Read access is still required: the client's
    // waitForValidatedUpload() polls/listens to this exact document
    // directly to know when it's safe to create the message doc — an
    // internal get()/exists() call from WITHIN another rule (like
    // messages' isValidatedMedia()) does not need this, only a real
    // client-facing read does.
    match /validatedUploads/{chatId}/files/{fileName} {
      allow read: if isSignedIn() &&
        request.auth.uid in get(/databases/$(database)/documents/chats/$(chatId)).data.members;
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // calls/{callId}  (Agora call signaling)
    // ---------------------------------------------------------------
    // Written exclusively via startCall/respondToCall/endCall
    // (functions/src/index.ts) — Admin SDK bypasses these rules entirely,
    // so `allow write: if false` doesn't block those callables, only a
    // client trying to create/update/delete a calls/ doc directly, which
    // would skip startCall's own push-notification side effect or let
    // either party forge the other's callerId/calleeId/status.
    match /calls/{callId} {
      allow read: if isSignedIn() && (
        resource.data.callerId == request.auth.uid ||
        resource.data.calleeId == request.auth.uid
      );
      allow write: if false;
    }

    // ---------------------------------------------------------------
    // personalEvents/{eventId}  (mugam-flutter's calendar/agreements)
    // ---------------------------------------------------------------
    match /personalEvents/{eventId} {
      // ЛЮДИ МЕРОПРИЯТИЯ = ВЛАДЕЛЕЦ ∪ `musicians`. Одно место на весь
      // файл, и ниже оно же читается правилом чтения (N49).
      //
      // Прежде здесь стояло только `uid in musicians`, и это тот самый
      // класс N30: поле значит РАЗНОЕ у двух писателей. Договор из
      // согласованного предложения (`onChatUpdated`) кладёт туда владельца
      // И вторую сторону; запись из календаря (`addPersonalEvent`) — только
      // выбранных, без владельца; mugam-v2 — только вторую сторону.
      //
      // Канон «владелец ∪ участники» к тому дню был вынесен уже дважды —
      // `eventPeople` на клиенте и `recipientsOf` на сервере, — а правила
      // остались ТРЕТЬИМ читателем, который о нём не знает. Импортировать
      // сюда нечего: правило пишется заново, и потому вынос канона в две
      // точки из трёх защиты не даёт вовсе.
      //
      // Цена промаха, посчитанная на данных прода 06.08: договоров 26,
      // владелец вне `musicians` у ОДИННАДЦАТИ. На них владелец не мог бы
      // отменить собственный договор — все четыре хода отмены доступны
      // только `isParty()`, а владельческая ветка их не пропускает вовсе
      // (`!touchesCancel()`). Вторая сторона при этом отменять могла бы.
      function isParty() {
        return isSignedIn() && (
          resource.data.ownerUid == request.auth.uid
          || request.auth.uid in resource.data.get('musicians', [])
        );
      }

      // ОТМЕНА ПО СОГЛАСИЮ. Поля отмены изъяты из обычной правки договора
      // (её по-прежнему делает только владелец) и разрешены исключительно
      // двумя ходами ниже — иначе «по согласию» осталось бы словом:
      // владелец мог бы выставить status:'cancelled' в одиночку, потому что
      // прежнее правило разрешало ему любое поле.
      function touchesCancel() {
        return changedKeys().hasAny([
          'status', 'cancelRequestedBy', 'cancelRequestedAt',
          'cancelConfirmedBy', 'cancelledAt',
        ]);
      }

      // Ход первый: предложить отмену. Только своим uid и только когда
      // запроса ещё нет — иначе одна сторона могла бы переписать чужой
      // запрос своим и следом подтвердить его как «чужой».
      // `lastActionBy`/`lastActionType` обязательны и здесь — не для
      // симметрии, а потому что сервер берёт имя автора уведомления
      // ИМЕННО из `lastActionBy`. Без них текст «{Ad} müqavilənin ləğvini
      // təklif etdi» назвал бы автора прошлого действия либо владельца
      // (`lastActionBy ?? ownerUid` в onPersonalEventUpdated) — то есть
      // при просьбе не от владельца врал бы всегда. Найдено 04.08 при
      // написании триггера, до выхода на устройства.
      function requestsCancel() {
        return changedKeys().hasOnly(['cancelRequestedBy', 'cancelRequestedAt',
                                      'lastActionBy', 'lastActionType'])
          && request.resource.data.cancelRequestedBy == request.auth.uid
          && resource.data.get('cancelRequestedBy', null) == null
          && resource.data.get('status', null) != 'cancelled'
          && request.resource.data.lastActionType == 'cancelRequested'
          && stampsSelf();
      }

      // Ход второй: подтвердить ЧУЖОЙ запрос. Своего подтвердить нельзя —
      // на этом всё «по согласию» и держится: без этой строки отмена
      // делается одной стороной в два тапа.
      //
      // `status != 'cancelled'` закрывает N36. Без него условие продолжало
      // выполняться и ПОСЛЕ отмены: `cancelRequestedBy` подтверждением не
      // очищается, поэтому вторая сторона могла подтвердить ещё раз и
      // переписать `cancelConfirmedBy` с `cancelledAt` на себя. Договор и
      // так отменён, но `cancelConfirmedBy` — единственная запись о том,
      // ЧЬЁ было решение, и переписываемой задним числом она быть не
      // может: «отменил Х» обязано значить «решение принял Х».
      function confirmsCancel() {
        return changedKeys().hasOnly(['status', 'cancelConfirmedBy', 'cancelledAt',
                                      'lastActionBy', 'lastActionType'])
          && request.resource.data.status == 'cancelled'
          && request.resource.data.cancelConfirmedBy == request.auth.uid
          && resource.data.get('cancelRequestedBy', null) != null
          && resource.data.get('cancelRequestedBy', null) != request.auth.uid
          && resource.data.get('status', null) != 'cancelled'
          && request.resource.data.lastActionType == 'cancelConfirmed'
          && stampsSelf();
      }

      // ВЫЙТИ ИЗ ЧУЖОГО МЕРОПРИЯТИЯ. Добавлено 03.08 по требованию
      // владельца: «своё удаляется у всех, чужое — только у меня».
      //
      // Зачем понадобилось: мероприятие, потерявшее силу, висит в
      // календаре участника, конфликтует с новыми датами, а его владелец
      // до уборки не добрался и связаться с ним нельзя. Удалять документ
      // целиком участнику нельзя — в мероприятии заняты и другие люди, у
      // них оно должно остаться.
      //
      // Ход намеренно узкий: меняется ТОЛЬКО список участников, и ровно на
      // удаление себя. Ни дату, ни место, ни статус этим ходом не тронуть,
      // и вычеркнуть кого-то ещё — тоже: новый список обязан совпасть со
      // старым минус сам просящий. Владельцу этот ход не нужен и не даётся
      // — своё он правит и удаляет обычным путём.
      // Признак автора обязателен: Firestore-триггер видит before/after, но
      // НЕ видит, кто писал. Без него «владелец убрал участника» и
      // «участник вышел сам» неразличимы — из `musicians` в обоих случаях
      // пропадает один uid, — и уведомление ушло бы не тому.
      //
      // Подделать его нельзя: `lastActionBy` обязан быть самим просящим.
      function stampsSelf() {
        return request.resource.data.lastActionBy == request.auth.uid;
      }

      function leavesEvent() {
        return changedKeys().hasOnly(['musicians', 'lastActionBy', 'lastActionType'])
          && stampsSelf()
          && request.resource.data.lastActionType == 'left'
          && resource.data.ownerUid != request.auth.uid
          && request.auth.uid in resource.data.get('musicians', [])
          && !(request.auth.uid in request.resource.data.musicians)
          && request.resource.data.musicians ==
             resource.data.musicians.removeAll([request.auth.uid]);
      }

      // ОТВЕТИТЬ ЗА СЕБЯ — шаг 4 работы «одна сущность» (`docs/plan.md`).
      //
      // Приём тот же, что у `clearedBy` в чатах (`writesOnlyOwnClearedBy`), и
      // довод тот же: там чужой ключ стёр бы историю, здесь — ОТВЕТИЛ БЫ ЗА
      // ЧЕЛОВЕКА. Ответ принадлежит тому, кто его дал, и запись, способная
      // поставить чужое согласие, отменяет весь смысл шага 4: с него
      // занятость календаря считается по согласию, а не по составу.
      //
      // ПРИЗНАК АВТОРА (`lastActionBy`) ЗДЕСЬ НЕ ТРЕБУЕТСЯ — и это отличие от
      // `leavesEvent` по существу, а не по недосмотру. Там из `musicians`
      // пропадает uid, и триггер, видящий before/after, не может сказать, КТО
      // писал: «вышел сам» и «владелец убрал» в данных неразличимы. Здесь
      // ПОСТУПОК САМ СЕБЯ НАЗЫВАЕТ — изменённый ключ карты и есть автор, а
      // подделать его нельзя: `affectedKeys().hasOnly([uid])` не пустит чужое
      // имя. Требовать сверх этого ещё и подпись значило бы просить человека
      // назваться дважды.
      //
      // ДВА ПОСЛЕДНИХ УСЛОВИЯ — ОДИН КЛАСС: ОБХОД ЧЕРЕЗ ОТСУТСТВИЕ.
      // Их легко принять за перестраховку и снять как лишние, поэтому довод
      // стоит здесь целиком.
      //
      //   • `uid in request.resource.data.answers` — нельзя УДАЛИТЬ свой ключ;
      //   • значение из трёх названных — нельзя записать чужую строку.
      //
      // Оба закрывают одну дорогу. `answerOf` читает и пустоту (ключа нет), и
      // мусор (значение не из набора) ОДИНАКОВО — как `notAsked`, а `notAsked`
      // означает «его не спрашивали». Значит участник, которому это оставить,
      // мог бы ОТМЕНИТЬ САМ ФАКТ ВОПРОСА — двумя разными способами, стерев
      // ключ или записав в него что угодно, — и выглядело бы это не как отказ,
      // а как будто владелец его никогда не звал.
      //
      // `notAsked` в списке значений нет и быть не может: оно и есть отсутствие
      // ключа, записывать его нечем.
      //
      // Владельцу ход не даётся (`ownerUid != uid`): у него своя ветка, а
      // согласия он не даёт вовсе — он вечер создал (N112).
      function answersForSelf() {
        return changedKeys().hasOnly(['answers'])
          && request.resource.data.answers
               .diff(resource.data.get('answers', {}))
               .affectedKeys().hasOnly([request.auth.uid])
          && request.auth.uid in request.resource.data.answers
          && request.resource.data.answers[request.auth.uid] in
             ['going', 'waiting', 'cant', 'left']
          && resource.data.ownerUid != request.auth.uid;
      }

      // СОСТОЯНИЕ ВЕЧЕРА СТАВИТ ВЛАДЕЛЕЦ — плашка на карточке (решение
      // автора 12.08). До этого хода `status` клиент писать почти не мог:
      // `cancelled` через согласие и `agreed` через возврат из «под вопроса»,
      // и всё.
      //
      // **`memberLeft` СРЕДИ ПОВОДОВ НЕТ, и это не забывчивость.** По решению
      // 12.08 уход участника больше не ставит вечер под вопрос: под вопросом
      // один человек, а не вечер. Повод переехал с документа на человека
      // (`answers[uid] == 'left'`), и принимать его здесь значило бы держать
      // открытой дорогу к состоянию, которого мы больше не порождаем.
      //
      // **`cancelled` СРЕДИ ЗНАЧЕНИЙ НЕТ** — отмена идёт своими ходами ниже:
      // у личного вечера одним владельцем, у договорённости по согласию.
      // Разреши его здесь — и защита «по согласию» обходится этим ходом.
      function ownerSetsStatus() {
        return changedKeys().hasOnly(['status', 'lastActionBy', 'lastActionType'])
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.status in ['agreed', 'unsettled']
          && request.resource.data.lastActionType in
             ['ownerFirm', 'ownerDoubt', 'workCancelled']
          && stampsSelf();
      }

      // ОТМЕНА ЛИЧНОГО ВЕЧЕРА — одним владельцем, и ТОЛЬКО у вечера без
      // договорённости.
      //
      // Довод, ради которого стоит `isAgree == false`: «расторгнуть
      // договорённость» и «работа отменилась» — два разных действия, сегодня
      // пишущие один и тот же `cancelled`. Первое требует согласия второй
      // стороны, потому что согласие его и составляет; второе — сообщение о
      // факте, и спрашивать о нём некого. Личный вечер никому не обещан.
      function ownerCancelsOwnEvent() {
        return changedKeys().hasOnly(['status', 'lastActionBy', 'lastActionType'])
          && resource.data.ownerUid == request.auth.uid
          && resource.data.get('isAgree', false) == false
          && request.resource.data.status == 'cancelled'
          && request.resource.data.lastActionType == 'ownerCancelled'
          && stampsSelf();
      }

      // ВОЗВРАТ ЛИЧНОГО ВЕЧЕРА — тем же путём, что отмена.
      //
      // **Отменить вдвоём, а вернуть в одиночку — дыра того же рода**, только
      // с другого конца: если возврат дешевле отмены, согласие обходится в два
      // хода. Поэтому у договорённости возврата здесь нет — он идёт парой
      // ходов-зеркал (отдельная работа, `docs/plan.md`).
      function ownerRestoresOwnEvent() {
        return changedKeys().hasOnly(['status', 'lastActionBy', 'lastActionType'])
          && resource.data.ownerUid == request.auth.uid
          && resource.data.get('isAgree', false) == false
          && resource.data.get('status', null) == 'cancelled'
          && request.resource.data.status == 'agreed'
          && request.resource.data.lastActionType == 'ownerRestored'
          && stampsSelf();
      }

      // СНЯТИЕ СТОЯЩЕГО ЗАПРОСА ОТМЕНЫ. Двумя ходами, а не одним, хотя в
      // данных они оставляют ОДИН И ТОТ ЖЕ след — пустые
      // `cancelRequestedBy`/`cancelRequestedAt`.
      //
      // Поступка два, и они разные:
      //   отзыв  — запросивший передумал, извещать надо вторую сторону;
      //   отказ  — вторая сторона не согласна, извещать надо запросившего.
      //
      // Триггер видит `before`/`after`, но НЕ видит, кто писал (тот же
      // довод, что у `leavesEvent`). Значит поступок обязан называться в
      // самой записи, иначе уведомление уйдёт не тому. Подделать название
      // нельзя: каждая дорога требует и своего автора, и своего имени —
      // отозвать может только запросивший, отказать только НЕ запросивший,
      // а `stampsSelf()` привязывает запись к тому, кто её делает.
      //
      // `status != 'cancelled'` — после подтверждения отзыв невозможен:
      // отменённый договор не возвращают снятием запроса. `status` этим
      // ходом не трогается вовсе (его нет в `hasOnly`), так что и
      // «расотменить» им нечего.
      //
      // Одновременность решают эти правила, а не UI: кто первым записал,
      // тот и прав. После отзыва подтверждение отклонится
      // (`cancelRequestedBy` стал null), после подтверждения отзыв
      // отклонится (`status == 'cancelled'`). Отказ проигравшему глотать
      // НЕЛЬЗЯ — он обязан стать словами «вторая сторона уже подтвердила
      // отмену».
      function clearsCancelFields() {
        return changedKeys().hasOnly(['cancelRequestedBy', 'cancelRequestedAt',
                                      'lastActionBy', 'lastActionType'])
          && request.resource.data.cancelRequestedBy == null
          && request.resource.data.cancelRequestedAt == null
          && resource.data.get('cancelRequestedBy', null) != null
          && resource.data.get('status', null) != 'cancelled'
          && stampsSelf();
      }

      // Запросивший передумал.
      function withdrawsCancelRequest() {
        return clearsCancelFields()
          && resource.data.get('cancelRequestedBy', null) == request.auth.uid
          && request.resource.data.lastActionType == 'cancelWithdrawn';
      }

      // Вторая сторона не согласна.
      // ХОД-ЗЕРКАЛО К ОТМЕНЕ: вернуть договор из «под вопросом» в силу.
      //
      // Третье состояние (`unsettled`) заводится тогда, когда у договора
      // пропала одна из опор: ушёл участник либо исчезла работа, ради
      // которой звали (Часть 6а `docs/plan.md`). Ставит его СЕРВЕР —
      // клиенту его писать незачем и нечем.
      //
      // А вот вернуть в силу решает ЧЕЛОВЕК, и потому ход нужен здесь.
      // Проверено чтением 09.08: сегодня записать `agreed` в существующий
      // документ не может НИКТО — владельцу запрещено трогать `status`
      // вовсе (`!touchesCancel()`), а единственный ход, который его
      // пишет, `confirmsCancel()`, прибит к значению `cancelled`.
      //
      // ПОЧЕМУ ТОЛЬКО ВЛАДЕЛЕЦ, а не любая сторона: «всё в силе» — это
      // решение того, кто договор держит. Участник, вернувшийся в состав,
      // ничего не решает про работу; а вторая сторона, если она не
      // согласна, располагает обычным ходом отмены по согласию.
      //
      // ПОЧЕМУ ТОЛЬКО ИЗ `unsettled`: из отменённого возврата нет — он
      // делается по согласию обеих сторон, и разворачивать его в
      // одиночку значило бы обойти это согласие. Из `agreed` возвращать
      // нечего.
      //
      // Значение прибито, как у соседа: иначе `hasOnly` пропустил бы
      // любую строку в поле, по которому судят все остальные ходы.
      //
      // ТОЛЬКО ИЗ ПОВОДА `memberLeft`, и это не сужение ради строгости.
      // Поводов у «под вопросом» два, а выход в силу осмыслен ровно у
      // одного:
      //   • ушёл участник — работа СОСТОЯЛАСЬ, вечер на месте, не хватает
      //     человека. «Продолжаю без него» — своё обещание владельца, и
      //     дать его он вправе;
      //   • исчезла работа — возвращать НЕ К ЧЕМУ. Родительский договор
      //     отменён по согласию обеих сторон, а обратного хода у отмены
      //     нет вовсе: `confirmsCancel` ставит `cancelled`, и ни одно
      //     правило оттуда не выпускает. Вечера нет; «всё в силе» на
      //     приглашении без работы обещает несуществующее.
      //
      // Без этой строки кнопки в приложении нет, а ДОРОГА ОТКРЫТА: чужой
      // клиент вернул бы в силу вечер, которого не существует.
      //
      // Да, правило читает ПОВОД. Это не нарушение границы «состояние не
      // знает отчего»: читает не состояние, а ПЕРЕХОД, и спрашивать,
      // откуда пришли, ему положено. Все четыре хода отмены смотрят на
      // `lastActionType` ровно так же.
      function restoresEvent() {
        return changedKeys().hasOnly(['status', 'lastActionBy', 'lastActionType'])
          && request.resource.data.status == 'agreed'
          && resource.data.get('status', null) == 'unsettled'
          && resource.data.get('lastActionType', null) == 'memberLeft'
          && resource.data.ownerUid == request.auth.uid
          && request.resource.data.lastActionType == 'restored'
          && stampsSelf();
      }

      function declinesCancelRequest() {
        return clearsCancelFields()
          && resource.data.get('cancelRequestedBy', null) != request.auth.uid
          && request.resource.data.lastActionType == 'cancelDeclined';
      }

      // Имя отмены нельзя поставить мимо двух дорог выше.
      //
      // Найдено тестом «нельзя снять запрос, которого нет» 04.08. Дыра
      // открывалась не там, где её ждали: запись `null` поверх уже
      // стоящего `null` НЕ попадает в `changedKeys()` — поле не менялось,
      // — поэтому `touchesCancel()` ложно, и такая правка уходила в ветку
      // обычной правки владельца. Снимать там нечего, но `lastActionType`
      // садился в документ, а серверу это поле — единственный источник
      // знания о том, что произошло: он разослал бы «вторая сторона
      // передумала» при том, что запроса не было вовсе.
      //
      // Тот же класс, что `stampsSelf`: подделывается не действие, а
      // РАССКАЗ о нём, и снаружи подделка неотличима от правды.
      // Перечислены ВСЕ четыре имени отмены, а не только два имени
      // снятия: любое из них — рассказ, которому сервер верит без
      // проверки, и поставить его мимо своей дороги нельзя ни одно.
      function namesCancelDeed() {
        return 'lastActionType' in changedKeys()
          && (request.resource.data.lastActionType == 'cancelRequested'
              || request.resource.data.lastActionType == 'cancelConfirmed'
              || request.resource.data.lastActionType == 'cancelWithdrawn'
              || request.resource.data.lastActionType == 'cancelDeclined');
      }

      // Тем же правилом, что и ходы отмены: «люди мероприятия» — понятие
      // одно, и записано оно теперь ровно в одном месте (N49). Прежде тут
      // стоял канон, а в `isParty()` его половина — и разошлись они молча,
      // потому что читались в разных строках и в разное время.
      allow read: if isParty();
      allow create: if isSignedIn() && request.resource.data.ownerUid == request.auth.uid;
      // Признак автора нельзя подделать НИКОМУ, включая владельца: если
      // `lastActionBy` в записи меняется, он обязан быть самим просящим.
      // Иначе уведомление «{Ad} sizi çıxardı» назвало бы не того человека,
      // а доверяет ему сервер безоговорочно — он для того и заведён.
      allow update: if isSignedIn()
        && (!changedKeys().hasAny(['lastActionBy']) || stampsSelf())
        && (
          (resource.data.ownerUid == request.auth.uid
             && !touchesCancel() && !namesCancelDeed())
          || (isParty() && (
               requestsCancel() || confirmsCancel() || leavesEvent()
               || withdrawsCancelRequest() || declinesCancelRequest()
               || restoresEvent() || answersForSelf()
               || ownerSetsStatus() || ownerCancelsOwnEvent()
               || ownerRestoresOwnEvent()
             ))
        );
      allow delete: if isSignedIn() && resource.data.ownerUid == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // agreements/{agreementId}  (mugam-v2 only)
    // ---------------------------------------------------------------
    match /agreements/{agreementId} {
      allow read: if isSignedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.get('toUid', null) == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid;
      // mugam-v2's own update call site has no fromUid/toUid check today;
      // this rule already tightens it to "one of the two named parties"
      // rather than reproducing that gap verbatim.
      allow update: if isSignedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.get('toUid', null) == request.auth.uid
      );
      allow delete: if false;
    }

    // ---------------------------------------------------------------
    // invites/{inviteId}  (mugam-v2 only)
    // ---------------------------------------------------------------
    match /invites/{inviteId} {
      allow read: if isSignedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.get('musicianId', null) == request.auth.uid
      );
      allow create: if isSignedIn() && request.resource.data.fromUid == request.auth.uid;
      // Recipient (musicianId) accepts/declines; creator can also change
      // status. Either party is restricted to touching status only.
      allow update: if isSignedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.get('musicianId', null) == request.auth.uid
      ) && changedKeys().hasOnly(['status']);
      allow delete: if isSignedIn() && resource.data.fromUid == request.auth.uid;
    }

    // ---------------------------------------------------------------
    // friendRequests/{requestId}  (mugam-flutter — Facebook-style friend
    // requests; see lib/firebase/models.dart's FriendRequest class for the
    // full lifecycle rationale)
    // ---------------------------------------------------------------
    match /friendRequests/{requestId} {
      // resource is null when the document doesn't exist yet (the normal
      // state for any two users who've never sent each other a request) —
      // without this branch, resource.data.fromUid on a null resource is a
      // rules evaluation error, which Firestore treats as permission-
      // denied, not as "not found." That silently broke every profile's
      // Add-friend button (via _buildFriendButton's own error branch,
      // which correctly hides the button on any read error — this is what
      // it was hiding). Allowing the null case is safe: it only lets a
      // signed-in user learn "no request exists between this uid pair,"
      // which reveals nothing sensitive.
      allow read: if isSignedIn() && (
        resource == null ||
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
      // Only the sender may create it, only about someone else, and only
      // ever starting out pending — the client never gets to create an
      // already-accepted request for itself.
      allow create: if isSignedIn() &&
        request.resource.data.fromUid == request.auth.uid &&
        request.resource.data.toUid is string &&
        request.resource.data.toUid != request.auth.uid &&
        request.resource.data.status == 'pending';
      // Accepting is the only update this collection ever allows, and only
      // the recipient (toUid) may perform it, only while still pending,
      // and only by touching status/respondedAt — never fromUid/toUid.
      allow update: if isSignedIn() &&
        resource.data.toUid == request.auth.uid &&
        resource.data.status == 'pending' &&
        request.resource.data.status == 'accepted' &&
        changedKeys().hasOnly(['status', 'respondedAt']);
      // Deletion covers cancel (sender, pending), decline (recipient,
      // pending) and unfriend (either side, accepted) — see
      // FriendRequest's doc comment for why these are one operation.
      allow delete: if isSignedIn() && (
        resource.data.fromUid == request.auth.uid ||
        resource.data.toUid == request.auth.uid
      );
    }

    // ---------------------------------------------------------------
    // maintenance/** — служебные записи серверных прогонов (сегодня это
    // отчёты сборщика сирот, orphanSweep.ts). Клиенту не нужны ни на
    // чтение, ни на запись, и содержат полные пути удалённых объектов.
    //
    // Правило избыточно: wildcard-правил верхнего уровня в этом файле
    // нет, поэтому всё неперечисленное и так запрещено. Написано явно
    // именно поэтому — чтобы ответ на вопрос «кто это читает» был в
    // правилах, а не выводился из их отсутствия.
    // ---------------------------------------------------------------
    match /maintenance/{doc=**} {
      allow read, write: if false;
    }

    // ---------------------------------------------------------------
    // Not fully scoped this pass — held at today's "signed-in only"
    // behavior deliberately, see file header. No regression from today,
    // but no improvement either; tracked as explicit follow-up.
    // ---------------------------------------------------------------
    match /gigs/{id} { allow read, write: if isSignedIn(); }
    match /board/{id} { allow read, write: if isSignedIn(); }
    match /market/{id} { allow read, write: if isSignedIn(); }
    match /stories/{id} { allow read, write: if isSignedIn(); }
    match /videos/{id} { allow read, write: if isSignedIn(); }
    // events и rooms сняты 07.08 вместе с показом вшитых концертов на
    // главном экране. В проде обе коллекции были пусты (0 документов), а
    // коллекция в Firestore существует ровно пока в ней есть документы —
    // значит удалять было нечего, снимается только доступ. Понадобится
    // Klub — имя свободно, но правило пишется уже не заглушкой.
    match /musicians/{id} { allow read, write: if isSignedIn(); }
    match /notifications/{id} { allow read, write: if isSignedIn(); }
    match /locations/{cityId} {
      allow read, write: if isSignedIn();
      match /districts/{districtId} {
        allow read, write: if isSignedIn();
      }
    }
  }
}
